{
  "name": "ecom-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @ecom/api dev",
    "dev:storefront": "pnpm --filter @ecom/storefront dev",
    "dev:admin": "pnpm --filter @ecom/admin dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ecom/storefront test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ecom/db generate",
    "db:migrate": "pnpm --filter @ecom/db migrate",
    "db:deploy": "pnpm --filter @ecom/db deploy",
    "db:seed": "pnpm --filter @ecom/db seed",
    "db:studio": "pnpm --filter @ecom/db studio",
    "deploy": "sst deploy --stage production",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sst": "^4.17.1",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@10.32.1"
}
