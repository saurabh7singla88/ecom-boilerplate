# Backend config for local development (apps/api + packages/db).
# Copy to .env — never commit real values. On AWS these come from SST secrets.

# Postgres from docker-compose (`pnpm db:up`).
# Cloud: the pooled Neon connection string, e.g.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/ecom?sslmode=require
DATABASE_URL="postgresql://ecom:ecom@localhost:5432/ecom"

# Local API server port.
API_PORT=9000
