{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./apps/storefront/src/app/globals.css",
  "tailwindFunctions": ["cn", "cva"],
  "overrides": [
    {
      "files": "apps/admin/**",
      "options": { "tailwindStylesheet": "./apps/admin/src/index.css" }
    }
  ]
}
