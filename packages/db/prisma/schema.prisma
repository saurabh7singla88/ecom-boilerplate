generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id          String    @id @default(cuid())
  handle      String    @unique
  name        String
  description String    @default("")
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String           @id @default(cuid())
  handle        String           @unique
  title         String
  description   String           @default("")
  status        ProductStatus    @default(DRAFT)
  /// Lowest variant price in paise. Kept in sync by the products service so
  /// listings can sort and display "from ₹…" without loading variants.
  minPricePaise Int              @default(0)
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  images        ProductImage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title               String
  sku                 String   @unique
  /// Price in paise (INR minor units), GST inclusive.
  pricePaise          Int
  compareAtPricePaise Int?
  stock               Int      @default(0)
  position            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)

  @@index([productId])
}
